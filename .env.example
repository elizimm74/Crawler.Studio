# Copy this file to .env.local and fill in the blanks. .env.local is never uploaded.
# In production, set the same names as environment variables on each host.

# ---------- both web (Vercel) and worker ----------
# Supabase "crawler" project. These two are PUBLIC by design; Row Level
# Security in the database keeps each user's data private.
NEXT_PUBLIC_SUPABASE_URL=https://txoimqedwfsuxoqiguop.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Qx4jian5THX3pU0Ocizymw_0NC4X9yo

# The public address of the website (used for share links and social cards),
# e.g. https://crawler.app . On your own computer you can leave it out.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SECRET. Also needed on the WEB app: the "Ask about this test" chat answers
# from the web server. console.anthropic.com
# (Put the same key on the worker too, see below.)
# ANTHROPIC_API_KEY=

# SECRET. Encrypts test-account logins while they wait in the queue.
# Make one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use the SAME value on the web app and the worker.
CREDENTIALS_KEY=

# ---------- worker only (NEVER put these on Vercel) ----------
# SECRET. Supabase dashboard -> Project Settings -> API Keys -> Secret keys.
SUPABASE_SECRET_KEY=
# SECRET. console.anthropic.com
ANTHROPIC_API_KEY=
# How many jobs one worker runs at the same time.
WORKER_CONCURRENCY=2

# ---------- Payments (Stripe) ----------
# From the Stripe dashboard (start in TEST mode: keys start with sk_test_ / whsec_).
# Never commit real values. Without these two, paid packs say "Coming soon".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The Stripe webhook route also needs SUPABASE_SECRET_KEY on the WEB server (to add purchased tests).

# Optional: look up a YouTube creator's recent views in video tests (YouTube Data API v3, free).
# Get a key at console.cloud.google.com -> APIs & Services -> enable "YouTube Data API v3" -> Credentials.
# Server-only (web app). Without it, founders type the views in by hand.
YOUTUBE_API_KEY=

# Launch email to the waitlist (npm run waitlist:send, see docs/waitlist.md). Local only, never commit real values.
RESEND_API_KEY=
MAIL_FROM="Crawler <hello@yourdomain.com>"
MAIL_ADDRESS=
# where the "Try Crawler" button in the launch email goes (defaults to the GitHub Pages site)
LAUNCH_URL=
# where unsubscribe.html is hosted (defaults to https://elizimm74.github.io/Study)
WAITLIST_SITE=

# ---------- founder pulse (worker only, optional) ----------
# Slack "incoming webhook" URL for your private stats channel. SECRET. Guide: docs/pulse.md
SLACK_WEBHOOK_URL=
# Daily report time (defaults: America/New_York, 21 = 9pm). SLACK_SKIP=signup,waitlist mutes those alerts.
DIGEST_TZ=
DIGEST_HOUR=
SLACK_SKIP=

# --- GitHub import (optional; docs/github.md). Without these the "Import from GitHub" button is hidden.
# GITHUB_APP_SLUG=crawler-studio
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY=   (the whole .pem; \n for newlines is fine)

# Pre-launch: show the early-access waitlist on the home page (/). Set to 1 in Vercel before
# launch; delete it and redeploy on launch day to bring the normal home page back.
WAITLIST_MODE=
# Optional: where the unsubscribe link in launch emails points. Default: LAUNCH_URL + /unsubscribe
UNSUBSCRIBE_URL=
